# GEMINI_API_KEY: Optional Gemini AI API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# SafeStay Database Configuration (MySQL)
DATABASE_URL="jdbc:mysql://localhost:3306/safestay_db?useSSL=false&serverTimezone=UTC"
DATABASE_USERNAME="safestay_user"
DATABASE_PASSWORD="safestay_password"

# Security & JWT
JWT_SECRET="safestay_jwt_secret_key_super_secure_btech_2026_demo_key"
JWT_EXPIRATION_MS="86400000"

# Twilio SMS / Alert Notification Service (Mock fallback active when empty)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# AI Acoustic Safety Service URL (FastAPI / Python)
AI_SERVICE_URL="http://localhost:8000"
AI_DISTRESS_THRESHOLD="90"

# Application Ports
PORT=3000
FRONTEND_URL="http://localhost:3000"

